# Copy to .env.local, or run `vercel env pull .env.local` once the project is linked.

# Shared secret the ESP32 sends as `Authorization: Bearer <DEVICE_KEY>`.
DEVICE_KEY=change-me

# Upstash Redis, injected by the Vercel integration. UPSTASH_REDIS_REST_URL/TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# State thresholds in mm (placeholders until calibrated after mounting).
T_LID=300
T_EMPTY=700
