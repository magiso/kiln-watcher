# Copy to .env.local, or run `vercel env pull .env.local --environment=production` once linked.
# The Upstash values are marked Sensitive on Vercel, so copy them from the Upstash console.

# Shared secret the ESP32 sends as `Authorization: Bearer <DEVICE_KEY>`.
DEVICE_KEY=change-me

# Upstash Redis. The Vercel integration uses the KILN_STORAGE_ prefix;
# KV_REST_API_* and UPSTASH_REDIS_REST_* also work.
KILN_STORAGE_KV_REST_API_URL=
KILN_STORAGE_KV_REST_API_TOKEN=

# Redis key prefix. Keep dev:kiln: locally so local runs never touch production keys.
KEY_PREFIX=dev:kiln:

# State thresholds in mm (placeholders until calibrated after mounting).
T_LID=300
T_EMPTY=700

# Show OFFLINE when the latest reading is older than this.
OFFLINE_AFTER_HOURS=24
